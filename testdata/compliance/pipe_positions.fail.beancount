; Like beancount's txn_strings, a pipe may stand anywhere among a
; transaction's strings, and each is reported on the line the strings start
; on; a third string drops the transaction. Anywhere else a pipe is a
; syntax error.
2020-01-01 open Assets:A
2020-01-01 open Assets:B

2020-01-02 * "Narration" |
  Assets:A   1 USD
  Assets:B  -1 USD

2020-01-03 * | "Narration"
  Assets:A   1 USD
  Assets:B  -1 USD

2020-01-04 * "P" | | "N"
  Assets:A   1 USD
  Assets:B  -1 USD

2020-01-05 * "P" | "N" | "X"
  Assets:A   1 USD
  Assets:B  -1 USD

2020-01-06 * "P
Q" | "N"
  Assets:A   1 USD
  Assets:B  -1 USD

2020-01-07 balance Assets:A | 1 USD

|
