; A seed for the differential fuzzer: short lots opened and covered, a
; reduction crossing zero, and ambiguous matches under STRICT.
2020-01-01 open Assets:Short "FIFO"
2020-01-01 open Assets:None "NONE"
2020-01-01 open Assets:Strict
2020-01-01 open Assets:Cash

2020-01-02 * "short"
  Assets:Short  -5 HOOL {50 USD}
  Assets:None  3 HOOL {50 USD}
  Assets:Strict  2 HOOL {50 USD, 2020-01-01}
  Assets:Strict  2 HOOL {50 USD, 2020-01-02}
  Assets:Cash

2020-01-03 * "cover and cross"
  Assets:Short  5 HOOL {}
  Assets:None  -5 HOOL {50 USD}
  Assets:Cash

2020-01-04 * "ambiguous, then exact"
  Assets:Strict  -1 HOOL {50 USD}
  Assets:Cash

2020-01-05 * "all of them"
  Assets:Strict  -4 HOOL {50 USD}
  Assets:Cash

2020-01-06 balance Assets:None -2 HOOL
