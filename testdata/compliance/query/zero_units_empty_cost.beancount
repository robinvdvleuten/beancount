; Like beancount, a posting of zero units at an empty cost {} is left out of
; the booked transaction: it has no cost to infer.
option "operating_currency" "USD"
2020-01-01 open Assets:B5
2020-01-01 open Assets:Cash

2020-01-02 * "seed"
  Assets:B5  10 HOOL {100 USD}
  Assets:Cash

2020-02-01 * "zero {}"
  Assets:B5  0 HOOL {}
  Assets:Cash  0 USD
