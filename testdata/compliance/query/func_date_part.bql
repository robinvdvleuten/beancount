SELECT date, date_part('weekday', date) AS a, date_part('dow', date) AS b, date_part('isoweekday', date) AS c, date_part('isodow', date) AS d, date_part('week', date) AS e, date_part('month', date) AS f, date_part('quarter', date) AS g, date_part('year', date) AS h, date_part('isoyear', date) AS i, date_part('decade', date) AS j, date_part('century', date) AS k, date_part('millennium', date) AS l, date_part('epoch', date) AS m, date_part('x', date) AS n
