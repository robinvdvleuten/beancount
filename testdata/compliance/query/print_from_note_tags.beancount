; The entries' tags and links columns read a note's and a document's, pushed
; tags included, not only a transaction's.
2020-01-01 open Assets:Cash
2020-01-01 open Expenses:Food

2020-01-02 note Assets:Cash "tagged" #trip
2020-01-03 note Assets:Cash "linked" ^receipt
2020-01-04 note Assets:Cash "plain"

pushtag #trip

2020-01-05 note Assets:Cash "pushed"
2020-01-06 document Assets:Cash "../docs/Assets/Checking/2020-03-14.statement.pdf"

poptag #trip

2020-01-07 document Assets:Cash "../docs/Assets/Checking/2020-03-14.statement.pdf" ^receipt
2020-01-08 document Assets:Cash "../docs/Assets/Checking/2020-03-14.statement.pdf"

2020-01-09 * "dinner" #trip
  Expenses:Food  1 USD
  Assets:Cash

2020-01-10 event "location" "Home"
