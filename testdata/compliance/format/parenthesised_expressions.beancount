; bean-format aligns one operator between two numbers in parentheses like a
; number; a nested or longer expression, or a space inside a parenthesis,
; leaves the line as written.
2020-01-01 open Assets:Cash
2020-01-01 open Expenses:Food

2020-01-02 * "Expressions"
  Expenses:Food  (1+2) USD
  Expenses:Food   ( 1 * 2 ) USD
  Expenses:Food  (-1 - 2) USD
  Expenses:Food  ((1 + 2) * 3) USD
  Expenses:Food  (1 + 2 + 3) USD
  Expenses:Food  (10 / 4) USD
  Expenses:Food  -1,000.5 USD
  Assets:Cash

2020-01-03 price HOOL  (1+2) USD
2020-01-03 price HOOL ( 1 * 2 ) USD
2020-01-03 price HOOL  (-1 - 2) USD
2020-01-03 price HOOL ((1 + 2) * 3) USD
2020-01-03 price HOOL (1 + 2 + 3) USD

2020-01-04 balance Assets:Cash  (1+2) USD
2020-01-04 balance Assets:Cash (-1 - 2) USD
2020-01-04 balance Assets:Cash ((1 + 2) * 3) USD
2020-01-04 balance Assets:Cash   (1 + 2 + 3) USD
