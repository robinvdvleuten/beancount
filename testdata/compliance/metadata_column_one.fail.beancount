; Metadata must be indented: a key: value line in column 1 is a syntax
; error, and the directive before it is kept without it.
2020-01-01 open Assets:Cash

2023-01-10 note Assets:Cash "x"
who: "me"
2023-01-11 note Assets:Cash "y"

2023-01-12 note Assets:Cash "after indented metadata"
  first: "a"
who: "me"

2023-01-13 * "after a transaction's metadata"
  first: "a"
who: "me"
  Assets:Cash  1 USD
  Assets:Cash  -1 USD

2023-01-14 * "after a posting"
  Assets:Cash  1 USD
  Assets:Cash  -1 USD
who: "me"

2023-01-15 * "after a posting's metadata"
  Assets:Cash  1 USD
    first: "a"
who: "me"
  Assets:Cash  -1 USD

2023-01-16 balance Assets:Cash 0 USD
