plugin "beancount.plugins.implicit_prices"

2020-01-01 open Assets:Cash
2020-01-01 open Assets:Stock
2020-01-01 open Assets:EUR
2020-01-01 open Income:Gains

2020-01-02 * "Buy"
  Assets:Stock  10 HOOL {100 USD}
  Assets:Cash

2020-01-03 * "Sell at a price"
  Assets:Stock  -5 HOOL {100 USD} @ 120 USD
  Assets:Cash   600 USD
  Income:Gains

2020-01-05 * "Exchange"
  Assets:EUR   100 EUR @@ 110 USD
  Assets:Cash
